{
  "name": "ems-backend",
  "version": "1.0.0",
  "description": "Production-ready multi-tenant Employee Management System SaaS backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:stage17": "node scripts/stage17-check.mjs",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "runtime:check": "node scripts/runtime-phase-check.mjs",
    "test:integration": "vitest run tests/integration tests/security",
    "security:check": "node scripts/stage18-security-check.mjs",
    "test:security": "vitest run tests/security tests/unit/security-controls.test.js",
    "check:stage19": "node scripts/stage19-check.mjs",
    "check:stage21": "node scripts/stage21-check.mjs",
    "check:stage24": "node scripts/stage24-check.mjs",
    "check:stage28": "node scripts/stage28-check.mjs"
  },
  "keywords": [
    "ems",
    "employee-management-system",
    "hr",
    "payroll",
    "attendance",
    "leave-management",
    "multi-tenant",
    "saas",
    "nodejs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Noel Victor",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.0.0",
    "bcryptjs": "^3.0.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.0",
    "date-fns": "^4.0.0",
    "decimal.js": "^10.0.0",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "uuid": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.0.0",
    "nodemon": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
