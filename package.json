        "multi-tenant",
        "saas",
        "nodejs",
        "express",
        "prisma",
        "postgresql"
    ],
    "author": "Noel Victor",
    "license": "ISC",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@prisma/client": "^6.0.0",
        "axios": "^1.0.0",
        "bcryptjs": "^3.0.0",
        "cookie-parser": "^1.4.0",
        "cors": "^2.8.0",
        "date-fns": "^4.0.0",
        "decimal.js": "^10.0.0",
        "dotenv": "^16.0.0",
        "express": "^5.0.0",
        "express-rate-limit": "^7.0.0",
        "helmet": "^8.0.0",
        "joi": "^18.0.0",
        "jsonwebtoken": "^9.0.0",
        "multer": "^2.0.0",
        "pino": "^9.0.0",
