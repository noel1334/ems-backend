NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info
MAX_FILE_SIZE=5242880

APP_BASE_URL="http://localhost:5000"

STORAGE_PROVIDER="supabase"

# Supabase Storage (free tier supported; keep service-role key backend-only)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET="employee-photos"
SUPABASE_DOCUMENT_BUCKET="employee-documents"
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# Browser-based face recognition descriptors are encrypted by the backend.
BIOMETRIC_ENCRYPTION_KEY=
FACE_API_DISTANCE_THRESHOLD=0.52

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL="https://api.paystack.co"

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"

# Optional platform administrator bootstrap (used by prisma seed)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Set true temporarily only when recovering/resetting an existing platform admin password.
SUPER_ADMIN_RESET_PASSWORD=false

# Payouts default to sandbox mode. Use provider TEST secret keys while validating.
PAYROLL_PAYOUTS_ENABLED=false
PAYROLL_PAYOUTS_MODE=sandbox
# Live transfers require explicit mode=live AND this separate acknowledgement. Never set during sandbox testing.
PAYROLL_PAYOUTS_LIVE_CONFIRMATION=false
# Payroll payout controls. Keep disabled until provider sandbox tests and reconciliation checks pass.
PAYROLL_PAYOUT_RECONCILIATION_ENABLED=true
PAYROLL_PAYOUT_RECONCILIATION_INTERVAL_MS=300000
# Optional dedicated HMAC key for cached recipient and batch preparation fingerprints.
# Set a high-entropy secret in the deployment environment; never commit real secrets.
PAYROLL_PAYOUT_RECIPIENT_FINGERPRINT_SECRET=
# Bank name resolution is intentionally off in sandbox by default; test providers may only resolve test accounts.
PAYROLL_PAYOUT_VALIDATE_BANK_ACCOUNTS_IN_SANDBOX=false
# Paystack NGN transfer fee defaults; review against your merchant contract and update at deployment.
PAYSTACK_TRANSFER_FEE_UP_TO_5000_NGN=10
PAYSTACK_TRANSFER_FEE_5001_TO_50000_NGN=25
PAYSTACK_TRANSFER_FEE_ABOVE_50000_NGN=50
PAYSTACK_TRANSFER_STAMP_DUTY_NGN=50
PAYSTACK_TRANSFER_STAMP_DUTY_THRESHOLD_NGN=10000
PAYSTACK_REGISTERED_PAYROLL_EXEMPTION=false
