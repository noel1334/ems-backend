NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info
MAX_FILE_SIZE=5242880

APP_BASE_URL="http://localhost:5000"

STORAGE_PROVIDER="supabase"

# Supabase Storage (free tier supported; keep service-role key backend-only)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET="employee-photos"
SUPABASE_DOCUMENT_BUCKET="employee-documents"
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# Facial recognition (CompreFace - free/open-source self-hosted API)
# Keep the API key server-side only.
COMPRE_FACE_URL="http://localhost:8000"
COMPRE_FACE_API_KEY=
COMPRE_FACE_THRESHOLD=0.80

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL="https://api.paystack.co"

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"
