generator client {
      provider = "prisma-client-js"
}

datasource db {
      provider = "postgresql"
        url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
      ACTIVE
        INACTIVE
          SUSPENDED
            LOCKED
}

enum Gender {
      MALE
        FEMALE
          OTHER
            PREFER_NOT_TO_SAY
}

enum EmploymentStatus {
      ACTIVE
        INACTIVE
          ON_LEAVE
            SUSPENDED
              TERMINATED
                RESIGNED
                  RETIRED
}

enum RoleScope {
      SYSTEM
        COMPANY
}

enum PermissionAction {
      CREATE
        READ
          UPDATE
            DELETE
              APPROVE
                EXPORT
                  MANAGE
}

enum AuditAction {
      CREATE
        UPDATE
          DELETE
            LOGIN
              LOGOUT
                LOGIN_FAILED
                  PASSWORD_CHANGED
                    PASSWORD_RESET
                      TOKEN_REFRESH
                        ACCOUNT_LOCKED
                          ACCOUNT_UNLOCKED
                            APPROVE
                              REJECT
                                EXPORT
                                  PAYMENT
                                    OTHER
}

enum SessionStatus {
      ACTIVE
        REVOKED
          EXPIRED
}

enum CompanyStatus {
      ACTIVE
        SUSPENDED
          INACTIVE
}

enum EmployeeType {
      FULL_TIME
        PART_TIME
          CONTRACT
            INTERN
              TEMPORARY
}

enum MaritalStatus {
      SINGLE
        MARRIED
          DIVORCED
            WIDOWED
              SEPARATED
                OTHER
}

// ============================================================
// COMPANY / TENANT
// ============================================================

model Company {
      id                String        @id @default(uuid())
        name              String
          legalName         String?
            slug              String        @unique
              email             String
                phone             String?
                  address           String?
                    city              String?
                      state             String?
                        country           String        @default("Nigeria")
                          timezone          String        @default("Africa/Lagos")
                            currency          String        @default("NGN")
                              status            CompanyStatus @default(ACTIVE)

                                createdAt         DateTime      @default(now())
                                  updatedAt         DateTime      @updatedAt

                                    users             User[]
                                      departments       Department[]
                                        designations      Designation[]
                                          employees         Employee[]
                                            roles             Role[]
                                              wallets           Wallet[]
                                                auditLogs         AuditLog[]
                                                  sessions          UserSession[]
                                                    systemSettings    SystemSetting[]

                                                      @@index([status])
                                                        @@index([slug])
                                                          @@map("companies")
}

// ============================================================
// USERS
// ============================================================

model User {
      id                String       @id @default(uuid())

        companyId         String?
          company           Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

            email             String
              passwordHash      String

                firstName         String
                  lastName          String
                    middleName        String?

                      phone             String?
                        avatarUrl         String?

                          status            UserStatus   @default(ACTIVE)

                            emailVerified     Boolean      @default(false)
                              emailVerifiedAt   DateTime?

                                failedLoginCount  Int          @default(0)
                                  lockedUntil       DateTime?

                                    lastLoginAt       DateTime?

                                      createdAt         DateTime     @default(now())
                                        updatedAt         DateTime     @updatedAt

                                          employee          Employee?
                                            roles             UserRole[]
                                              sessions          UserSession[]
                                                auditLogs         AuditLog[]

                                                  @@unique([companyId, email])
                                                    @@index([email])
                                                      @@index([companyId])
                                                        @@index([status])
                                                          @@map("users")
}

// ============================================================
// ROLES
// ============================================================

model Role {
      id                String       @id @default(uuid())

        companyId         String?
          company           Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

            name              String
              description       String?
                scope             RoleScope    @default(COMPANY)

                  isSystem          Boolean      @default(false)
                    isActive          Boolean      @default(true)

                      createdAt         DateTime     @default(now())
                        updatedAt         DateTime     @updatedAt

                          users             UserRole[]
                            permissions       RolePermission[]

                              @@unique([companyId, name])
                                @@index([companyId])
                                  @@index([scope])
                                    @@map("roles")
}

// ============================================================
// PERMISSIONS
// ============================================================

model Permission {
      id                String            @id @default(uuid())

        module            String
          resource          String
            action            PermissionAction

              description       String?
                isActive          Boolean           @default(true)

                  createdAt         DateTime          @default(now())
                    updatedAt         DateTime          @updatedAt

                      roles             RolePermission[]

                        @@unique([module, resource, action])
                          @@index([module])
                            @@index([resource])
                              @@map("permissions")
}

// ============================================================
// USER ↔ ROLE
// ============================================================

model UserRole {
      id                String       @id @default(uuid())

        userId            String
          roleId            String

            user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
              role              Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

                assignedAt        DateTime     @default(now())

                  @@unique([userId, roleId])
                    @@index([userId])
                      @@index([roleId])
                        @@map("user_roles")
}

// ============================================================
// ROLE ↔ PERMISSION
// ============================================================

model RolePermission {
      id                String       @id @default(uuid())

        roleId            String
          permissionId      String

            role              Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
              permission        Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

                createdAt         DateTime     @default(now())

                  @@unique([roleId, permissionId])
                    @@index([roleId])
                      @@index([permissionId])
                        @@map("role_permissions")
}

// ============================================================
// USER SESSIONS
// ============================================================

model UserSession {
      id                String        @id @default(uuid())

        userId            String
          companyId         String?

            user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
              company           Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

                refreshTokenHash  String

                  ipAddress         String?
                    userAgent         String?
                      deviceName        String?

                        status            SessionStatus @default(ACTIVE)

                          expiresAt         DateTime
                            lastUsedAt        DateTime?
                              revokedAt         DateTime?

                                createdAt         DateTime      @default(now())
                                  updatedAt         DateTime      @updatedAt

                                    @@index([userId])
                                      @@index([companyId])
                                        @@index([status])
                                          @@index([expiresAt])
                                            @@map("user_sessions")
}

// ============================================================
// DEPARTMENTS
// ============================================================

model Department {
      id                String        @id @default(uuid())

        companyId         String
          company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

            name              String
              code              String?
                description       String?
                  isActive          Boolean       @default(true)

                    createdAt         DateTime      @default(now())
                      updatedAt         DateTime      @updatedAt

                        designations      Designation[]
                          employees         Employee[]

                            @@unique([companyId, name])
                              @@unique([companyId, code])
                                @@index([companyId])
                                  @@map("departments")
}

// ============================================================
// DESIGNATIONS
// ============================================================

model Designation {
      id                String       @id @default(uuid())

        companyId         String
          departmentId      String?

            company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
              department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

                name              String
                  code              String?
                    description       String?
                      isActive          Boolean      @default(true)

                        createdAt         DateTime     @default(now())
                          updatedAt         DateTime     @updatedAt

                            employees         Employee[]

                              @@unique([companyId, name])
                                @@unique([companyId, code])
                                  @@index([companyId])
                                    @@index([departmentId])
                                      @@map("designations")
}

// ============================================================
// EMPLOYEES
// ============================================================

model Employee {
      id                  String           @id @default(uuid())

        companyId           String
          userId              String?          @unique

            departmentId        String?
              designationId       String?

                company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
                  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
                    department          Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
                      designation         Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)

                        employeeNumber      String

                          firstName           String
                            lastName            String
                              middleName          String?

                                email               String?
                                  phone               String?

                                    gender              Gender?
                                      dateOfBirth         DateTime?
                                        maritalStatus       MaritalStatus?

                                          employeeType        EmployeeType     @default(FULL_TIME)
                                            employmentStatus    EmploymentStatus @default(ACTIVE)

                                              dateOfJoining       DateTime
                                                dateOfLeaving       DateTime?

                                                  address             String?
                                                    city                String?
                                                      state               String?
                                                        country             String           @default("Nigeria")

                                                          emergencyName       String?
                                                            emergencyPhone      String?
                                                              emergencyRelation   String?

                                                                createdAt           DateTime         @default(now())
                                                                  updatedAt           DateTime         @updatedAt

                                                                    @@unique([companyId, employeeNumber])
                                                                      @@index([companyId])
                                                                        @@index([departmentId])
                                                                          @@index([designationId])
                                                                            @@index([employmentStatus])
                                                                              @@index([employeeType])
                                                                                @@map("employees")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
      id                String      @id @default(uuid())

        companyId         String?
          userId            String?

            company           Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
              user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

                action            AuditAction

                  module            String?
                    resource          String?
                      resourceId        String?

                        description       String?

                          ipAddress         String?
                            userAgent         String?

                              metadata          Json?

                                createdAt         DateTime    @default(now())

                                  @@index([companyId])
                                    @@index([userId])
                                      @@index([action])
                                        @@index([module])
                                          @@index([resourceId])
                                            @@index([createdAt])
                                              @@map("audit_logs")
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================

model SystemSetting {
      id                String      @id @default(uuid())

        companyId         String
          company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

            key               String
              value             Json

                description       String?
                  isEncrypted       Boolean     @default(false)

                    createdAt         DateTime    @default(now())
                      updatedAt         DateTime    @updatedAt

                        @@unique([companyId, key])
                          @@index([companyId])
                            @@map("system_settings")
}

// ============================================================
// WALLET FOUNDATION
// ============================================================

model Wallet {
      id                String       @id @default(uuid())

        companyId         String       @unique
          company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

            currency          String       @default("NGN")

              balance           Decimal      @default(0) @db.Decimal(18, 2)

                isActive          Boolean      @default(true)

                  createdAt         DateTime     @default(now())
                    updatedAt         DateTime     @updatedAt

                      ledgerEntries     WalletLedgerEntry[]

                        @@index([currency])
                          @@map("wallets")
}

// ============================================================
// WALLET LEDGER
// ============================================================

model WalletLedgerEntry {
      id                String      @id @default(uuid())

        walletId          String

          wallet            Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

            type              String
              reference         String?

                debit             Decimal     @default(0) @db.Decimal(18, 2)
                  credit            Decimal     @default(0) @db.Decimal(18, 2)

                    balanceBefore     Decimal     @db.Decimal(18, 2)
                      balanceAfter      Decimal     @db.Decimal(18, 2)

                        description       String?
                          metadata          Json?

                            createdAt         DateTime    @default(now())

                              @@index([walletId])
                                @@index([reference])
                                  @@index([createdAt])
                                    @@map("wallet_ledger_entries")
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
