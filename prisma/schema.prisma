generator client {
      provider = "prisma-client-js"
}

datasource db {
      provider = "postgresql"
        url      = env("DATABASE_URL")
}

/*
|--------------------------------------------------------------------------
| ENUMS
|--------------------------------------------------------------------------
*/

enum UserStatus {
      ACTIVE
        INACTIVE
          SUSPENDED
            LOCKED
}

enum Gender {
      MALE
        FEMALE
          OTHER
}

enum EmploymentStatus {
      ACTIVE
        INACTIVE
          SUSPENDED
            TERMINATED
              ON_LEAVE
}

enum EmployeeType {
      FULL_TIME
        PART_TIME
          CONTRACT
            INTERN
              TEMPORARY
}

enum MaritalStatus {
      SINGLE
        MARRIED
          DIVORCED
            WIDOWED
              SEPARATED
}

enum RoleScope {
      SYSTEM
        COMPANY
}

enum PermissionAction {
      CREATE
        READ
          UPDATE
            DELETE
              APPROVE
                EXPORT
                  MANAGE
}

enum AuditAction {
      LOGIN
        LOGOUT
          TOKEN_REFRESH
            TOKEN_REUSE_DETECTED
              PASSWORD_CHANGE
                PASSWORD_RESET_REQUEST
                  PASSWORD_RESET
                    CREATE
                      UPDATE
                        DELETE
                          APPROVE
                            REJECT
                              EXPORT
                                LOGIN_FAILED
                                  ACCOUNT_LOCKED
                                    ACCOUNT_UNLOCKED
}

enum SessionStatus {
      ACTIVE
        REVOKED
          EXPIRED
}

enum CompanyStatus {
      ACTIVE
        SUSPENDED
          INACTIVE
}

enum PlanType {
      FREE
        STARTER
          PROFESSIONAL
            ENTERPRISE
}

enum DocumentType {
      PASSPORT
        NATIONAL_ID
          DRIVERS_LICENSE
            VOTERS_CARD
              CERTIFICATE
                CONTRACT
                  OFFER_LETTER
                    RESUME
                      OTHER
}

enum WalletEntryType {
      CREDIT
        DEBIT
          REFUND
            ADJUSTMENT
}

enum WalletEntryStatus {
      PENDING
        COMPLETED
          FAILED
            REVERSED
}

/*
|--------------------------------------------------------------------------
| COMPANY / TENANT
|--------------------------------------------------------------------------
*/

model Company {
      id String @id @default(uuid())

        name      String
          legalName String?

            /*
               * Used for EMS tenant identification.
                  *
                     * Example:
                        * akanjilmt
                           * shawama
                              *
                                 * Future domain resolver can map:
                                    * akanjilmt.ems.com
                                       * shawama.ems.com
                                          */
                                            slug String @unique

                                              email String?
                                                phone String?

                                                  address String?
                                                    city    String?
                                                      state   String?

                                                        country  String @default("Nigeria")
                                                          timezone String @default("Africa/Lagos")
                                                            currency String @default("NGN")

                                                              status CompanyStatus @default(ACTIVE)

                                                                plan                PlanType @default(FREE)
                                                                  isSubscriptionActive Boolean  @default(false)

                                                                    /*
                                                                       * Payment / wallet configuration.
                                                                          *
                                                                             * Actual payment integration will be implemented
                                                                                * in the payment stages.
                                                                                   */
                                                                                     paystackSubaccountId   String?
                                                                                       flutterwaveSubaccountId String?

                                                                                         walletBalance Decimal @default(0) @db.Decimal(18, 2)

                                                                                           createdAt DateTime @default(now())
                                                                                             updatedAt DateTime @updatedAt

                                                                                               users        User[]
                                                                                                 departments  Department[]
                                                                                                   designations Designation[]
                                                                                                     employees    Employee[]

                                                                                                       roles Role[]

                                                                                                         sessions UserSession[]

                                                                                                           auditLogs AuditLog[]

                                                                                                             systemSettings SystemSetting[]

                                                                                                               wallets Wallet[]

                                                                                                                 @@index([status])
                                                                                                                   @@index([slug])
                                                                                                                     @@map("companies")
}

/*
|--------------------------------------------------------------------------
| USERS
|--------------------------------------------------------------------------
*/

model User {
      id String @id @default(uuid())

        companyId String?

          email      String
            passwordHash String

              firstName  String
                lastName   String
                  middleName String?

                    phone     String?
                      avatarUrl String?

                        status UserStatus @default(ACTIVE)

                          emailVerified   Boolean   @default(false)
                            emailVerifiedAt DateTime?

                              failedLoginCount Int       @default(0)
                                lockedUntil      DateTime?

                                  lastLoginAt DateTime?

                                    createdAt DateTime @default(now())
                                      updatedAt DateTime @updatedAt

                                        company Company? @relation(
                                                fields: [companyId],
                                                    references: [id],
                                                        onDelete: Cascade
                                        )

                                          employee Employee?

                                            roles UserRole[]

                                              sessions UserSession[]

                                                auditLogs AuditLog[]

                                                  @@unique([companyId, email])
                                                    @@index([email])
                                                      @@index([companyId])
                                                        @@index([status])
                                                          @@map("users")
}

/*
|--------------------------------------------------------------------------
| RBAC
|--------------------------------------------------------------------------
*/

model Role {
      id String @id @default(uuid())

        companyId String?

          name        String
            description String?

              scope RoleScope @default(COMPANY)

                isSystem Boolean @default(false)
                  isActive Boolean @default(true)

                    createdAt DateTime @default(now())
                      updatedAt DateTime @updatedAt

                        company Company? @relation(
                                fields: [companyId],
                                    references: [id],
                                        onDelete: Cascade
                        )

                          users UserRole[]

                            permissions RolePermission[]

                              @@unique([companyId, name])
                                @@index([companyId])
                                  @@index([scope])
                                    @@index([isActive])
                                      @@map("roles")
}

model Permission {
      id String @id @default(uuid())

        module   String
          resource String
            action   PermissionAction

              description String?

                isActive Boolean @default(true)

                  createdAt DateTime @default(now())
                    updatedAt DateTime @updatedAt

                      roles RolePermission[]

                        @@unique([module, resource, action])
                          @@index([module])
                            @@index([resource])
                              @@index([action])
                                @@map("permissions")
}

model UserRole {
      userId String
        roleId String

          assignedAt DateTime @default(now())

            user User @relation(
                    fields: [userId],
                        references: [id],
                            onDelete: Cascade
            )

              role Role @relation(
                    fields: [roleId],
                        references: [id],
                            onDelete: Cascade
              )

                @@id([userId, roleId])
                  @@index([roleId])
                    @@map("user_roles")
}

model RolePermission {
      roleId       String
        permissionId String

          assignedAt DateTime @default(now())

            role Role @relation(
                    fields: [roleId],
                        references: [id],
                            onDelete: Cascade
            )

              permission Permission @relation(
                    fields: [permissionId],
                        references: [id],
                            onDelete: Cascade
              )

                @@id([roleId, permissionId])
                  @@index([permissionId])
                    @@map("role_permissions")
}

/*
|--------------------------------------------------------------------------
| AUTHENTICATION SESSIONS
|--------------------------------------------------------------------------
*/

model UserSession {
      id String @id @default(uuid())

        userId    String
          companyId String?

            /*
               * Only the hash is stored.
                  * Raw refresh tokens are never persisted.
                     */
                       refreshTokenHash String

                         ipAddress String?
                           userAgent String?
                             deviceName String?

                               status SessionStatus @default(ACTIVE)

                                 expiresAt DateTime
                                   lastUsedAt DateTime?

                                     revokedAt DateTime?

                                       createdAt DateTime @default(now())
                                         updatedAt DateTime @updatedAt

                                           user User @relation(
                                                fields: [userId],
                                                    references: [id],
                                                        onDelete: Cascade
                                           )

                                             company Company? @relation(
                                                    fields: [companyId],
                                                        references: [id],
                                                            onDelete: Cascade
                                             )

                                               @@index([userId])
                                                 @@index([companyId])
                                                   @@index([status])
                                                     @@index([expiresAt])
                                                       @@map("user_sessions")
}

/*
|--------------------------------------------------------------------------
| DEPARTMENTS
|--------------------------------------------------------------------------
*/

model Department {
      id String @id @default(uuid())

        companyId String

          name String
            code String

              description String?

                isActive Boolean @default(true)

                  createdAt DateTime @default(now())
                    updatedAt DateTime @updatedAt

                      company Company @relation(
                            fields: [companyId],
                                references: [id],
                                    onDelete: Cascade
                      )

                        designations Designation[]

                          employees Employee[]

                            @@unique([companyId, name])
                              @@unique([companyId, code])

                                @@index([companyId])
                                  @@index([companyId, isActive])

                                    @@map("departments")
}

/*
|--------------------------------------------------------------------------
| DESIGNATIONS
|--------------------------------------------------------------------------
*/

model Designation {
      id String @id @default(uuid())

        companyId String

          departmentId String?

            name String
              code String

                description String?

                  isActive Boolean @default(true)

                    createdAt DateTime @default(now())
                      updatedAt DateTime @updatedAt

                        company Company @relation(
                                fields: [companyId],
                                    references: [id],
                                        onDelete: Cascade
                        )

                          department Department? @relation(
                                fields: [departmentId],
                                    references: [id],
                                        onDelete: SetNull
                          )

                            employees Employee[]

                              @@unique([companyId, name])
                                @@unique([companyId, code])

                                  @@index([companyId])
                                    @@index([companyId, departmentId])
                                      @@index([companyId, isActive])

                                        @@map("designations")
}

/*
|--------------------------------------------------------------------------
| EMPLOYEES
|--------------------------------------------------------------------------
*/

model Employee {
      id String @id @default(uuid())

        companyId String

          /*
             * Company-scoped employee number.
                *
                   * Example:
                      * EMP-000001
                         * EMP-000002
                            */
                              employeeNumber String

                                firstName  String
                                  middleName String?
                                    lastName   String

                                      email String?
                                        phone String?

                                          gender Gender?

                                            dateOfBirth DateTime?

                                              maritalStatus MaritalStatus?

                                                address String?
                                                  city    String?
                                                    state   String?
                                                      country String @default("Nigeria")

                                                        jobTitle String?

                                                          employeeType EmployeeType @default(FULL_TIME)

                                                            employmentStatus EmploymentStatus @default(ACTIVE)

                                                              hireDate        DateTime
                                                                terminationDate DateTime?

                                                                  departmentId  String?
                                                                    designationId String?
                                                                      managerId     String?

                                                                        /*
                                                                           * Employee profile photo.
                                                                              *
                                                                                 * The storage provider is abstracted from the
                                                                                    * employee module.
                                                                                       */
                                                                                         profilePhotoUrl String?
                                                                                           profilePhotoKey String?

                                                                                             createdAt DateTime @default(now())
                                                                                               updatedAt DateTime @updatedAt

                                                                                                 company Company @relation(
                                                                                                        fields: [companyId],
                                                                                                            references: [id],
                                                                                                                onDelete: Cascade
                                                                                                 )

                                                                                                   department Department? @relation(
                                                                                                        fields: [departmentId],
                                                                                                            references: [id],
                                                                                                                onDelete: SetNull
                                                                                                   )

                                                                                                     designation Designation? @relation(
                                                                                                            fields: [designationId],
                                                                                                                references: [id],
                                                                                                                    onDelete: SetNull
                                                                                                     )

                                                                                                       manager Employee? @relation(
                                                                                                            "EmployeeManager",
                                                                                                                fields: [managerId],
                                                                                                                    references: [id],
                                                                                                                        onDelete: SetNull
                                                                                                       )

                                                                                                         subordinates Employee[] @relation(
                                                                                                                "EmployeeManager"
                                                                                                         )

                                                                                                           /*
                                                                                                              * Optional application account.
                                                                                                                 *
                                                                                                                    * An employee does not automatically need
                                                                                                                       * a login account.
                                                                                                                          */
                                                                                                                            user User?

                                                                                                                              bankAccounts EmployeeBankAccount[]

                                                                                                                                education EmployeeEducation[]

                                                                                                                                  experiences EmployeeExperience[]

                                                                                                                                    documents EmployeeDocument[]

                                                                                                                                      @@unique([companyId, employeeNumber])

                                                                                                                                        @@index([companyId])
                                                                                                                                          @@index([companyId, employmentStatus])
                                                                                                                                            @@index([companyId, employeeType])
                                                                                                                                              @@index([companyId, departmentId])
                                                                                                                                                @@index([companyId, designationId])
                                                                                                                                                  @@index([companyId, managerId])
                                                                                                                                                    @@index([companyId, email])

                                                                                                                                                      @@map("employees")
}

/*
|--------------------------------------------------------------------------
| EMPLOYEE BANK ACCOUNTS
|--------------------------------------------------------------------------
*/

model EmployeeBankAccount {
      id String @id @default(uuid())

        employeeId String

          bankName      String
            accountName   String
              accountNumber String

                accountType String?

                  isPrimary Boolean @default(true)
                    isActive  Boolean @default(true)

                      createdAt DateTime @default(now())
                        updatedAt DateTime @updatedAt

                          employee Employee @relation(
                                fields: [employeeId],
                                    references: [id],
                                        onDelete: Cascade
                          )

                            @@index([employeeId])
                              @@index([employeeId, isPrimary])
                                @@index([employeeId, isActive])

                                  @@map("employee_bank_accounts")
}

/*
|--------------------------------------------------------------------------
| EMPLOYEE EDUCATION
|--------------------------------------------------------------------------
*/

model EmployeeEducation {
      id String @id @default(uuid())

        employeeId String

          institution  String
            qualification String

              fieldOfStudy String?

                startDate DateTime?
                  endDate   DateTime?

                    grade String?

                      description String?

                        createdAt DateTime @default(now())
                          updatedAt DateTime @updatedAt

                            employee Employee @relation(
                                    fields: [employeeId],
                                        references: [id],
                                            onDelete: Cascade
                            )

                              @@index([employeeId])
                                @@map("employee_education")
}

/*
|--------------------------------------------------------------------------
| EMPLOYEE PREVIOUS EXPERIENCE
|--------------------------------------------------------------------------
*/

model EmployeeExperience {
      id String @id @default(uuid())

        employeeId String

          companyName String

            jobTitle String?

              employmentType String?

                startDate DateTime?
                  endDate   DateTime?

                    responsibilities String?

                      reasonForLeaving String?

                        createdAt DateTime @default(now())
                          updatedAt DateTime @updatedAt

                            employee Employee @relation(
                                    fields: [employeeId],
                                        references: [id],
                                            onDelete: Cascade
                            )

                              @@index([employeeId])
                                @@map("employee_experience")
}

/*
|--------------------------------------------------------------------------
| EMPLOYEE DOCUMENTS
|--------------------------------------------------------------------------
*/

model EmployeeDocument {
      id String @id @default(uuid())

        employeeId String

          documentType DocumentType

            title String

              fileName String
                fileUrl  String

                  /*
                     * Provider-specific storage identifier.
                        */
                          storageKey String?

                            mimeType String?
                              fileSize Int?

                                expiresAt DateTime?

                                  isActive Boolean @default(true)

                                    uploadedAt DateTime @default(now())
                                      updatedAt DateTime @updatedAt

                                        employee Employee @relation(
                                                fields: [employeeId],
                                                    references: [id],
                                                        onDelete: Cascade
                                        )

                                          @@index([employeeId])
                                            @@index([employeeId, documentType])
                                              @@index([employeeId, isActive])

                                                @@map("employee_documents")
}

/*
|--------------------------------------------------------------------------
| AUDIT LOG
|--------------------------------------------------------------------------
*/

model AuditLog {
      id String @id @default(uuid())

        companyId String?
          userId    String?

            action AuditAction

              module   String?
                resource String?
                  resourceId String?

                    description String?

                      ipAddress String?
                        userAgent String?

                          /*
                             * Additional structured information.
                                */
                                  metadata Json?

                                    createdAt DateTime @default(now())

                                      company Company? @relation(
                                            fields: [companyId],
                                                references: [id],
                                                    onDelete: Cascade
                                      )

                                        user User? @relation(
                                                fields: [userId],
                                                    references: [id],
                                                        onDelete: SetNull
                                        )

                                          @@index([companyId])
                                            @@index([userId])
                                              @@index([action])
                                                @@index([module])
                                                  @@index([resource])
                                                    @@index([resourceId])
                                                      @@index([createdAt])

                                                        @@map("audit_logs")
}

/*
|--------------------------------------------------------------------------
| SYSTEM SETTINGS
|--------------------------------------------------------------------------
*/

model SystemSetting {
      id String @id @default(uuid())

        companyId String

          key   String
            value String?

              createdAt DateTime @default(now())
                updatedAt DateTime @updatedAt

                  company Company @relation(
                        fields: [companyId],
                            references: [id],
                                onDelete: Cascade
                  )

                    @@unique([companyId, key])
                      @@index([companyId])

                        @@map("system_settings")
}

/*
|--------------------------------------------------------------------------
| WALLET
|--------------------------------------------------------------------------
*/

model Wallet {
      id String @id @default(uuid())

        companyId String

          balance Decimal @default(0) @db.Decimal(18, 2)

            currency String @default("NGN")

              isActive Boolean @default(true)

                createdAt DateTime @default(now())
                  updatedAt DateTime @updatedAt

                    company Company @relation(
                            fields: [companyId],
                                references: [id],
                                    onDelete: Cascade
                    )

                      ledgerEntries WalletLedgerEntry[]

                        @@unique([companyId])
                          @@index([companyId])
                            @@map("wallets")
}

/*
|--------------------------------------------------------------------------
| WALLET LEDGER
|--------------------------------------------------------------------------
*/

model WalletLedgerEntry {
      id String @id @default(uuid())

        walletId String

          type WalletEntryType

            status WalletEntryStatus @default(PENDING)

              amount Decimal @db.Decimal(18, 2)

                balanceBefore Decimal @db.Decimal(18, 2)
                  balanceAfter  Decimal @db.Decimal(18, 2)

                    reference String @unique

                      description String?

                        metadata Json?

                          createdAt DateTime @default(now())

                            wallet Wallet @relation(
                                    fields: [walletId],
                                        references: [id],
                                            onDelete: Cascade
                            )

                              @@index([walletId])
                                @@index([walletId, type])
                                  @@index([walletId, status])
                                    @@index([createdAt])

                                      @@map("wallet_ledger_entries")
}
                            )
}
                    )
}
                  )
}
                                        )
                                      )
}
                                        )
}
                            )
}
                            )
}
                          )
}
                                                                                                         )
                                                                                                       )
                                                                                                     )
                                                                                                   )
                                                                                                 )
}
                          )
                        )
}
                      )
}
                                             )
                                           )
}
              )
            )
}
              )
            )
}
}
                        )
}
                                        )
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
